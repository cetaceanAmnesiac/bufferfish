---
import Base from '../layouts/Base.astro';
import { marked } from 'marked';
import fs from 'node:fs';
import path from 'node:path';

const mdPath = path.join(process.cwd(), 'src/content/privacy.md');
const raw = fs.readFileSync(mdPath, 'utf-8');
const content = marked(raw);
---

<Base title="Privacy Policy — COMPANTHROFRAC" description="Privacy policy for the COMPANTHROFRAC browser extension">
  <p class="muted" style="margin-bottom: 2rem;"><a href="/">← buffer.fish</a></p>
  <article set:html={content} />
</Base>
